{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ph", "destination": "/index.html" },
    { "source": "/id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/fft-logo.:ext",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
